{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LAN Drop",
  "version": "2.0.0",
  "identifier": "com.landrop.transfer",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "内网投送 - LAN Drop",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LAN Drop OpenSource",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 LAN Drop. All rights reserved.",
    "category": "Utility",
    "shortDescription": "LAN Drop 局域网极速跨端即时文件投送与通信工具",
    "longDescription": "基于 Tauri v2 + Rust 构建的纯内网 P2P 高性能文件传输与通信客户端。"
  }
}
