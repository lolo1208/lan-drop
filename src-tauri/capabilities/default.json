{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LAN Drop 默认能力集与系统事件权限",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:default",
    "dialog:default",
    "fs:default",
    "notification:default"
  ]
}
